# Virtualenv
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# The library database lives in ~/.config/rsvp-reader, but keep stray
# copies out of the repo just in case.
*.db
*.db-wal
*.db-shm

# Generated icons ARE committed (small, and needed to build from a clean
# checkout); the macOS .icns is built in CI only.
assets/icon.icns
*.iconset/

# Node / Vite / pnpm
node_modules/
dist-ssr/
*.local

# OAuth client files downloaded from the Google Cloud console hold a client
# secret. Never commit one (docs/architecture/decisions.md).
client_secret*.json
*.tsbuildinfo

# Tauri
src-tauri/target/

# Capacitor
android/app/build/
android/.gradle/
android/build/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# OCR engine and language data, copied by scripts/copy-ocr-assets.mjs
/public/ocr/

# Playwright output
/test-results/
/playwright-report/
